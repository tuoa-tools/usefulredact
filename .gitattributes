# Store text with LF line endings on every machine, whatever each one's core.autocrlf says.
# Without this a file edited on Windows can come back with every line changed, which makes
# a diff unreadable and can fail the format checks in CI.
* text=auto eol=lf

# Never touch these: they are not text, whatever git guesses.
*.png binary
*.jpg binary
*.pdf binary
*.whl binary
*.onnx binary
